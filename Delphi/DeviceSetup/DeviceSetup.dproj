<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{69D733D0-8A5E-4BE1-83EC-2E8ED9BA55D4}</ProjectGuid>
    <ProjectVersion>18.1</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>DeviceSetup.dpr</MainSource>
    <ProjectName>DeviceSetup</ProjectName>
    <AppType>Application</AppType>
    <Config Condition="'$(Config)' == ''">Debug</Config>
    <Platform Condition="'$(Platform)' == ''">Win32</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Config)' == 'Base' or '$(Base)' != ''">
    <Base>true</Base>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Config)' == 'Debug'">
    <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>true</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Config)' == 'Release'">
    <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
    <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
    <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
  </PropertyGroup>

  <PropertyGroup>
    <Icon_MainIcon>DeviceSetup.ico</Icon_MainIcon>
    <AppEnableRuntimeThemes>true</AppEnableRuntimeThemes>
    <AppDPIAwarenessMode>system</AppDPIAwarenessMode>
    <VerInfo_IncludeVerInfo>true</VerInfo_IncludeVerInfo>
    <VerInfo_MajorVer>1</VerInfo_MajorVer>
    <VerInfo_MinorVer>1</VerInfo_MinorVer>
    <VerInfo_Release>0</VerInfo_Release>
    <VerInfo_Locale>1033</VerInfo_Locale>
    <VerInfo_Keys>FileDescription=Mobile Servicing Tools;FileVersion=1.1.0.0;InternalName=DeviceSetup;OriginalFilename=DeviceSetup.exe;ProductName=Mobile Servicing Tools;ProductVersion=1.1.0</VerInfo_Keys>
    <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
  </PropertyGroup>

  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="MainForm.pas">
      <Form>frmMain</Form>
    </DCCReference>
    <DCCReference Include="Main2Form.pas">
      <Form>frmMain2</Form>
    </DCCReference>
    <DCCReference Include="DeviceCatalog.pas" />
    <DCCReference Include="DaLoader.pas" />
    <DCCReference Include="ToolbarIcons.pas" />
    <DCCReference Include="SampleAssets.pas" />
    <DCCReference Include="SampleControls.pas" />
    <DCCReference Include="AppInfo.pas" />
    <DCCReference Include="LogView.pas" />
    <DCCReference Include="UsbDetect.pas" />
    <DCCReference Include="SettingsDialog.pas" />
    <DCCReference Include="SelfTest.pas" />
  </ItemGroup>

  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>VCLApplication</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">DeviceSetup.dpr</Source>
        </Source>
      </Delphi.Personality>
    </BorlandProject>
  </ProjectExtensions>

  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
