unit MtkStatus;

{$IFDEF FPC}
  {$MODE DELPHI}
{$ENDIF}

{ MediaTek BootROM / download-agent status codes.

  Every command answer ends with a 16-bit status word. Values up to $00FF
  mean "accepted"; anything above is a BootROM or DA error, and the vendor
  tools print its name. This unit holds that name table so the log can say
  "error(0x2001 DA_IMAGE_SIG_VERIFY_FAIL)" instead of a bare number.

  Generated from the public MediaTek status-code table
  (bkerler/mtkclient, mtkclient/Library/error.py, GPLv3). }

interface

uses
{$IFDEF FPC}
  SysUtils;
{$ELSE}
  System.SysUtils;
{$ENDIF}

