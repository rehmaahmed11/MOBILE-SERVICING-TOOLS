{ True when a status word means "the device accepted the command". }
function StatusIsOk(AStatus: Word): Boolean;
{ 'DA_IMAGE_SIG_VERIFY_FAIL', or '' when the code is not in the table. }
function StatusName(AStatus: Word): string;
{ What the log prints: 'OK', '0x2001 DA_IMAGE_SIG_VERIFY_FAIL'. }
function StatusText(AStatus: Word): string;

implementation

function StatusIsOk(AStatus: Word): Boolean;
begin
  Result := AStatus <= $00FF;
end;

function StatusName(AStatus: Word): string;
var
  Lo, Hi, Mid: Integer;
begin
  Result := '';
  Lo := 0;
  Hi := CMtkStatusCodeCount - 1;
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CMtkStatusCodes[Mid].Code = AStatus then
      Exit(CMtkStatusCodes[Mid].Name)
    else if CMtkStatusCodes[Mid].Code < AStatus then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
end;

function StatusText(AStatus: Word): string;
begin
  if AStatus = 0 then
    Result := 'OK'
  else
  begin
    Result := '0x' + IntToHex(AStatus, 4);
    if StatusName(AStatus) <> '' then
      Result := Result + ' ' + StatusName(AStatus);
  end;
end;

end.
